# CronMail 后端镜像
# 同一镜像，不同 command 启动不同进程（API / Celery Worker / Celery Beat）
FROM python:3.12-slim

WORKDIR /app

# 安装系统依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    procps \
    poppler-utils \
    antiword \
    && rm -rf /var/lib/apt/lists/*

# 安装 Python 依赖
COPY backend/requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# 复制后端代码
COPY backend/ .

# 创建非 root 用户
RUN groupadd -r cronmail && useradd -r -g cronmail -s /bin/false cronmail \
    && chown -R cronmail:cronmail /app
USER cronmail

# 暴露 API 端口
EXPOSE 8000

# 默认启动 API 服务（Celery Worker/Beat 通过 K8s command 覆盖）
CMD ["uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000"]
